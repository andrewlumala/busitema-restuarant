PORT=4000

# Lock this to your real frontend URL before deploying publicly (e.g. https://busitema-restaurant.up.railway.app)
FRONTEND_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=busitema_canteen

JWT_SECRET=replace-with-a-long-random-string

# Verifies mobile money webhook calls are genuinely from the provider — set this
# before going live, or anyone can fake a "payment successful" callback
MOMO_WEBHOOK_SECRET=

# SMS provider (e.g. Africa's Talking) — used for "order ready" and password reset texts.
# Leave blank during local testing; messages just print to the server console instead.
SMS_API_KEY=
SMS_USERNAME=

# Merchant/collection codes — which account gets credited
MTN_MERCHANT_CODE=171790
AIRTEL_MERCHANT_CODE=434366

# Fill in once you have MTN MoMo / Airtel Money developer accounts
# (the merchant codes above cannot authenticate API calls on their own)
# MTN: get MTN_MOMO_SUBSCRIPTION_KEY from momodeveloper.mtn.com, then run
#      `MTN_SUBSCRIPTION_KEY=xxx node scripts/mtn-sandbox-setup.js` to get the two below
MTN_MOMO_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
